{
  "navigationFallback": { "rewrite": "/index.html", "exclude": ["/assets/*", "/privacy/*", "/terms/*", "/install.sh", "/install.ps1", "/sw.js"] },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://github.com https://api.sociobot.in"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } }
  ]
}
